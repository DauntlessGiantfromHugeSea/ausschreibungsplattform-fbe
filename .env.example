# Datenbank
DATABASE_URL=sqlite:///./data/tenders.db

# Scheduler (lokale Zeit, 24h-Format)
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0

# Optional: E-Mail-Benachrichtigung bei neuen hochrelevanten Treffern.
# NOTIFY_EMAIL leer lassen, um Mails zu deaktivieren.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ausschreibungsbot@example.com

# Zielregionen (kommasepariert), beeinflussen den Relevanzscore
TARGET_REGIONS=Sachsen,Brandenburg,Berlin,Sachsen-Anhalt,Thüringen

# Score-Schwelle für "hochrelevant" (0-100)
HIGH_RELEVANCE_THRESHOLD=70

# User-Agent fuer Scraper
SCRAPER_USER_AGENT=FBE-Ausschreibungsbot/1.0 (+kontakt@flüssigboden-engineering.de)

# HTTP Timeout in Sekunden
HTTP_TIMEOUT=30
