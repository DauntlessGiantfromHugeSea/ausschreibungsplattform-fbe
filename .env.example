# --- Auth (Single-Admin) -----------------------------------------------
# Benutzername + Passwort fuer das Webinterface.
# UNBEDINGT vor dem Produktiveinsatz aendern!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fbe-admin-bitte-aendern
# Geheimnis zum Signieren der Session-Cookies. Bei leerem Wert wird beim
# Start ein zufaelliger erzeugt (Sessions ueberleben dann keinen Restart).
# Tipp: openssl rand -hex 32
SESSION_SECRET=

# Cookies nur ueber HTTPS senden. Auf true setzen sobald Let's Encrypt
# aktiv ist. Vorher false lassen, sonst sperrt man sich aus.
SESSION_HTTPS_ONLY=false

# --- Datenbank ---------------------------------------------------------
DATABASE_URL=sqlite:///./data/tenders.db

# Scheduler
# Continuous-Mode: alle N Minuten ein Suchlauf. Default 60.
# Auf 0 setzen, um stattdessen den taeglichen Cron unten zu nutzen.
SCHEDULER_INTERVAL_MINUTES=60

# Daily-Cron (nur aktiv wenn SCHEDULER_INTERVAL_MINUTES=0)
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0

# Optional: E-Mail-Benachrichtigung bei neuen hochrelevanten Treffern.
# NOTIFY_EMAIL leer lassen, um Mails zu deaktivieren.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ausschreibungsbot@example.com

# Tageszusammenfassung: zeitplan fuer den taeglichen Versand (lokale Zeit).
# Wird nur eingeplant wenn NOTIFY_EMAIL + SMTP_HOST gesetzt sind.
SUMMARY_HOUR=7
SUMMARY_MINUTE=0

# Zielregionen (kommasepariert) - default LEER = bundesweit, keine
# Region-Bevorzugung im Scoring. Wenn gesetzt: Tender in diesen
# Bundeslaendern bekommen +10 Punkte.
# Beispiel: TARGET_REGIONS=Sachsen,Sachsen-Anhalt,Thüringen
TARGET_REGIONS=

# Score-Schwelle für "hochrelevant" (0-100)
HIGH_RELEVANCE_THRESHOLD=70

# User-Agent fuer Scraper
SCRAPER_USER_AGENT=FBE-Ausschreibungsbot/1.0 (+kontakt@fluessigboden-engineering.de)

# HTTP Timeout in Sekunden
HTTP_TIMEOUT=30
