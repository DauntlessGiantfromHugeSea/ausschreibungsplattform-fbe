# Plattform-URL (auf demselben Server typisch http://localhost:8000)
FBE_TENDER_URL=http://localhost:8000

# Shared-Secret: muss IDENTISCH zur fbe-tender .env-Variable ENRICHER_TOKEN sein.
# Beispiel: openssl rand -hex 32
ENRICHER_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Loop-Tuning
POLL_INTERVAL_S=600
BATCH_LIMIT=5
PAGE_TIMEOUT_MS=30000

# Deep-Crawl (wieviele Unterseiten/PDFs pro Tender)
MAX_SUBPAGES=4
MAX_PDFS=3
MAX_TEXT_PER_SOURCE=6000
MAX_TOTAL_TEXT=22000

# Wo die .md-Dateien geschrieben werden (im Container).
# Wird beim docker run auf /srv/fbe-enrich vom Host gemountet.
ENRICH_DIR=/data/enrich

LOG_LEVEL=INFO

# ---- Optional: Portal-Logins ----
# Wenn gesetzt, loggt sich der Enricher einmalig auf der jeweiligen
# Domain ein, bevor er Tender-URLs auf dieser Domain crawlt. Cookies
# bleiben im Browser-Context erhalten.
#
# Format: JSON-Objekt, Schluessel = Host-Suffix.
# Wegen JSON in einer .env: einzelne Zeile, doppelte Quotes escapen!
# Alternative: PORTAL_LOGINS_FILE=/path/to/logins.json
#
# Beispiel evergabe.de:
# PORTAL_LOGINS_JSON={"evergabe.de":{"login_url":"https://www.evergabe.de/login","username_selector":"input[name='user[email]']","password_selector":"input[name='user[password]']","submit_selector":"button[type='submit']","username":"USER","password":"PASS","success_selector":"a[href*='logout']"}}
#
# Hinweis: Selektoren bei den Portalen zuerst per Browser-DevTools verifizieren.
# Sie aendern sich gelegentlich.
PORTAL_LOGINS_JSON=
# PORTAL_LOGINS_FILE=/data/enrich/portal_logins.json
